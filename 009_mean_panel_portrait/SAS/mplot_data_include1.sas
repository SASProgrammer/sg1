data labs;
  infile datalines delimiter='|' truncover;
  input varn 3. @;
  if varn = 1 then do;
    length lbstresn  8 lbstunit $30 lbtest $4 trt $8 trtgroup  8 usubjid  8 visit $8 visitwk  8 ;
    lbstresn = . ;
    lbstunit = ' ';
    lbtest = ' ';
    trt = ' ';
    trtgroup = . ;
    usubjid = . ;
    visit = ' ';
    visitwk = . ;
    retain lbstresn lbstunit lbtest trt trtgroup usubjid visit visitwk ;
  end;
  if varn = 1 then input @6 lbstresn  8. ;
  if varn = 2 then input @6 lbstunit $30. ;
  if varn = 3 then input @6 lbtest $4. ;
  if varn = 4 then input @6 trt $8. ;
  if varn = 5 then input @6 trtgroup  8. ;
  if varn = 6 then input @6 usubjid  8. ;
  if varn = 7 then input @6 visit $8. ;
  if varn = 8 then input @6 visitwk  8. ;
  if varn = 8 then output;
