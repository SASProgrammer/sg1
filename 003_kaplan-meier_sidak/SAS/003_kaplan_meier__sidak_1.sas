*-----------------------------------------------------------------------------------
  5) Run proc lifetest to get output datsets.                        (template code)
 -----------------------------------------------------------------------------------;
 ods output quartiles = Dir_.&Program_._qrt(where=(percent=50)); 
 ods output HomTests  = Dir_.&Program_._tst ;
 ods output SurvDiff  = Dir_.&Program_._srvdif ;

 proc lifetest data=BMT method=KM CONFTYPE=LINEAR;
      strata trt / test=(LOGRANK) adjust=sidak;
      time T * status(0) ;  
 run; 

*-----------------------------------------------------------------------------------
  6) Put subject count, median, median CIs, into treatement format.  (template code)
 -----------------------------------------------------------------------------------;
 proc means data=BMT noprint;
    var T;
    output out=count n=n max=max;
    by trt;
 run;

 data _null_;
    set count;
    nvar='N'||trim(left(put(trt,2.0)));
    call symput(nvar,trim(left(put(n,3.0))));
    maxvar='MAX'||trim(left(put(trt,2.0)));
    call symput(maxvar,trim(left(put(max,4.0))));
  run;
 %put Maximum Time For Each Treatment Group:;
 %put     max1 = &max1; 
 %put     max2 = &max2; 
 %put     max3 = &max3; 

 %let _medval1 = ;
 %let _medval2 = ;
 %let _medval3 = ;

 data _null_;
    set Dir_.&Program_._qrt;
        var_name='_medval'||trim(left(put(trt,2.0)));
        if Percent=50 then  
           call symput(var_name,trim(left(put(estimate,9.1))) || ' (' ||
                 trim(left(put(lowerlimit,9.1))) || ', ' || trim(left(put(upperlimit,9.1))) || ')' );
 run;
 %put Median (95% CI):;
 %put     _medval1 = &_medval1; 
 %put     _medval2 = &_medval2; 
 %put     _medval3 = &_medval3; 

*-------------------------------------------------------------------------------------
 7) Redefine format with big N and Median (95% CI)                     (template code)
 -------------------------------------------------------------------------------------;
 proc format;
     value group
     1="ALL (N=&N1) , &_medval1"
     2="AML-Low Risk (N=&N2) , &_medval2"
     3="AML-High Risk (N=&N3), &_medval3"
  ;
run;
 
 
*-----------------------------------------------------------------------------------
  8) Put overall log-rank p-value into a macro variable.              (template code)
 -----------------------------------------------------------------------------------;
 %let _p_value = ;

 data _null_;
    set Dir_.&Program_._tst;
        length _p_value $ 10;
        if ProbChiSq < .0001 then _p_value = "p < .0001";
                             else _p_value = "p = "||trim(left(put(probchisq,PVALUE6.4)));
        call symput("_p_value", 'Among Treatment Log Rank: '||_p_value);
 run;
 %put Log Rank p-value:;
 %put     _p_value = &_p_value; 
 
 
*-----------------------------------------------------------------------------------
  9) Put pairwise sidak adjusted p-values into a macro variables.    (template code)
 -----------------------------------------------------------------------------------;
 %let _pair1 = ;
 %let _pair2 = ;
 %let _pair3 = ;
 data pair;
      set Dir_.&Program_._srvdif;
      length _p_sidak $20 _pair $ 200;
      var_name='_pair'||trim(left(put(_n_,2.0)));
      if sidak < .0001 then _p_sidak = ": p < .0001";
                       else _p_sidak = ": p = "||trim(left(put(sidak,PVALUE6.4)));
      _pair=trim(left(put(stratum1,trt.)))||' / '||trim(left(put(stratum2,trt.)))||_p_sidak;
      call symput(var_name,trim(_pair));
 run;
 %put Pairwise sidak adjusted p-values:;
 %put     _pair1 = &_pair1; 
 %put     _pair2 = &_pair2; 
 %put     _pair3 = &_pair3; 


*-----------------------------------------------------------------------------------
 10) Run proc lifetest to get SG output datset.                      (template code)
 -----------------------------------------------------------------------------------;
 ods graphics on;
 ods output survivalplot  =Dir_.&Program_._sg; 
 
 proc lifetest data=BMT method=KM CONFTYPE=LINEAR
      plots(only)=(survival(cb=hw atrisk=0 to 2500 by 500 strata=overlay test));
      strata group / test=(LOGRANK) adjust=sidak;
      time T *status(0) ;  
      format group group.;
 run; 

*-----------------------------------------------------------------------------------
 11) Post process SG output datsets.                                 (template code)
     a) Offset error bars - a good offset amount for two treatments is 0.005*X_MAX
     b) Retain prior error bar from prior time point where there is data.
     c) Delete error bar if collapsed to a single line 
     d) Offset censors - a good offset amount for censors is 0.002*X_MAX
 -----------------------------------------------------------------------------------;
 data Dir_.&Program_._sg; 

     set Dir_.&Program_._sg;by stratumnum time;

     retain lag_HW_UCL lag_HW_LCL lag_SURVIVAL;

     if first.stratumnum then do;
        lag_HW_UCL  = .;
        lag_HW_LCL  = .;
        lag_SURVIVAL = .;
     end;
     
     if HW_UCL>.   then lag_HW_UCL   = HW_UCL;
     if HW_LCL>.   then lag_HW_LCL   = HW_LCL;
     if SURVIVAL>. then lag_SURVIVAL = SURVIVAL;

     if lag_HW_LCL>. or lag_HW_UCL>. then do;
        if StratumNum=1 and mod(time,500)=0 and time<=&max1 then x_err_bar=time-10;
        if StratumNum=2 and mod(time,500)=0 and time<=&max2 then x_err_bar=time;
        if StratumNum=3 and mod(time,500)=0 and time<=&max3 then x_err_bar=time+10;
        if lag_HW_UCL=lag_HW_LCL then do;
           lag_HW_UCL=.; lag_HW_LCL=.;  /* Delete error bar from plot where the top and bottom 
                                             plot as a line on the survival curve*/
        end;
     end;

     if censored>. then do;
        if time=lag(time) and stratum=lag(stratum) then censor_count+1;
        Y_censored = censored +.02; 
        X_censored = time - (censor_count * .02);  
        marker_censored="|";
     end;
     else censor_count=1;
                   
     if StratumNum=1 and mod(time,500)=0 then at_risk_1=atrisk;
     if StratumNum=2 and mod(time,500)=0 then at_risk_2=atrisk;
     if StratumNum=3 and mod(time,500)=0 then at_risk_3=atrisk;
  run;
  
